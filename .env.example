# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH BIẾN MÔI TRƯỜNG: CHỊ LỆ XAI GÍNH
# ==============================================================================
# Sao chép file này thành .env.local và điền các giá trị thực tế từ Supabase Dashboard:
# Project Settings -> API -> Project URL & Project API Keys
# ==============================================================================

# 1. Supabase Cấu hình Công khai (Dùng cho cả Client và Server qua SSR Cookies)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_key...

# 2. Supabase Service Role Key (Chỉ sử dụng phía Server trong Route Handlers, TUYỆT ĐỐI KHÔNG để lộ ra client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_supabase_service_role_key...

# 3. Thông tin khởi tạo tài khoản Owner đầu tiên (Tùy chọn cho script setup)
INITIAL_OWNER_USERNAME=chile
INITIAL_OWNER_PASSWORD=ChiLeQuan@2026
INITIAL_OWNER_NAME=Chị Lệ (Chủ quán)

# 4. Địa chỉ gốc triển khai (Phục vụ tạo link QR bàn)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app
