# Supabase Configuration
# Thay các giá trị này bằng Project URL và Anon Key từ Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (dành cho API server, không để lộ ra client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push VAPID Keys (tạo bằng lệnh: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:chile@xaiginh.vn
